# ============================================================
# SPG Reporting Bot — Environment Variables
# ============================================================
# Salin file ini menjadi .env dan isi nilainya.
# JANGAN pernah commit file .env ke repository!
# ============================================================

# Token Bot Telegram (dapatkan dari @BotFather di Telegram)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Nama file JSON credentials Google Service Account
# (download dari Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_FILE=your-service-account-credentials.json

# ID Google Spreadsheet (ambil dari URL spreadsheet)
# Contoh URL: https://docs.google.com/spreadsheets/d/SHEET_ID_INI/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here

# Nama worksheet (tab) di dalam spreadsheet
GOOGLE_SHEET_NAME=NAMA_WORKSHEET
